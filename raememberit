#!/usr/bin/env bash
# raememberit — the front door. One word, plain questions, nothing written before you say yes.
#
#   ./raememberit install                  # set it up, or update it if it is already here
#   ./raememberit update                   # bring an existing setup up to this version
#   ./raememberit status                   # is it installed, is it current, is anything wrong
#   ./raememberit uninstall                # remove the tools; your memories stay
#
#   ./raememberit <verb> --yes             # take every default, ask nothing (scripts, CI)
#   ./raememberit install --name NAME      # what Claude should call you
#   ./raememberit uninstall --and-my-memories
#   ./raememberit status --commands        # how far your edited commands are from the shipped ones
#   ./raememberit <verb> --config-dir DIR  # a different Claude Code folder
#   ./raememberit <verb> --advanced ...    # hand everything after it to install.sh / uninstall.sh unchanged
#
# WHAT THIS IS. install.sh and uninstall.sh do the work and know every option. This knows the
# PERSON: it looks at the computer, asks at most three plain questions, shows what it is about
# to do, does it, and says what changed — in words that do not require knowing what a hook, a
# corpus or a plugin is. There is one route (the recommended one), chosen here, not asked.
# Everything install.sh can do is still reachable behind --advanced.
#
# bash 3.2 compatible (macOS /bin/bash).
set -uo pipefail

SRC="$(cd "$(dirname "$0")" && pwd)"
VERB=""; YES=0; NAME=""; TARGET="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"; TARGET_EXPLICIT=0
AND_MEMORIES=0; SHOW_COMMANDS=0; ADVANCED=0; ADV_ARGS=""
NEW_VERSION="$(tr -d ' \n' < "$SRC/VERSION" 2>/dev/null || echo unknown)"
# Running from inside a placed plugin tree: the engine lives in the plugin, so the mechanics differ
# (install.sh --plugin), but nothing the person sees does.
PLUGIN=0; [ -f "$SRC/.claude-plugin/plugin.json" ] && [ -d "$SRC/engine" ] && PLUGIN=1

# ── how things are said ─────────────────────────────────────────────────────────────
say()   { printf '\n  \033[1m%s\033[0m\n' "$*"; }
line()  { printf '  %s\n' "$*"; }
good()  { printf '    \033[1;32m✓\033[0m %s\n' "$*"; }
note()  { printf '    · %s\n' "$*"; }
flag()  { printf '    \033[1;33m!\033[0m %s\n' "$*"; }
oops()  { printf '\n  \033[1;31m✗ %s\033[0m\n' "$*" >&2; }
interactive() { [ "$YES" = 0 ] && [ -t 0 ] && [ -t 1 ] && [ -r /dev/tty ]; }
# ask_yn "question" default(y|n) -> 0 yes, 1 no. Without a person present, the default answers.
ask_yn() {
  local q="$1" d="${2:-y}" r
  [ "$YES" = 1 ] && return 0                       # --yes means yes to everything
  if ! interactive; then [ "$d" = y ]; return; fi  # nobody there: the default answers
  if [ "$d" = y ]; then printf '\n  %s [Y/n]  ' "$q"; else printf '\n  %s [y/N]  ' "$q"; fi
  read -r r </dev/tty || r=""
  case "$r" in "") [ "$d" = y ] ;; [yY]*) return 0 ;; *) return 1 ;; esac
}
ask_text() {  # ask_text "question" default -> prints the answer
  local q="$1" d="$2" r
  if ! interactive; then printf '%s' "$d"; return; fi
  printf '\n  %s [%s]  ' "$q" "$d"; read -r r </dev/tty || r=""
  printf '%s' "${r:-$d}"
}
run_quiet() {  # run_quiet LOGFILE cmd... -> 0, or prints the tail and returns 1
  local log="$1"; shift
  if "$@" >"$log" 2>&1; then return 0; fi
  oops "something went wrong. The last lines of the log:"
  tail -15 "$log" | sed 's/^/      /' >&2
  printf '\n  Full log: %s\n  Please send it to whoever gave you raememberit.\n' "$log" >&2
  return 1
}
tilde() { printf '%s' "$1" | sed "s|^$HOME|~|"; }
plural() { if [ "$1" = 1 ]; then printf '%s %s' "$1" "$2"; else printf '%s %ss' "$1" "$2"; fi; }   # plural 3 note -> "3 notes"

# ── what the computer looks like ────────────────────────────────────────────────────
have() { command -v "$1" >/dev/null 2>&1; }
cfgget() { [ -f "$TARGET/raememberit/.config" ] || return 0; sed -n "s|^$1=||p" "$TARGET/raememberit/.config" | tail -1; }
resolve_mem() {
  MEM="${RAEMEMBERIT_MEMORY_DIR:-}"
  [ -z "$MEM" ] && [ -f "$TARGET/settings.json" ] && MEM=$(jq -r '.env.RAEMEMBERIT_MEMORY_DIR // empty' "$TARGET/settings.json" 2>/dev/null || true)
  [ -n "$MEM" ] || MEM="$TARGET/memory"
  # a folder named on the command line outranks a variable the shell happened to carry
  if [ "$TARGET_EXPLICIT" = 1 ]; then case "$MEM" in "$TARGET"/*) : ;; *) MEM="$TARGET/memory" ;; esac; fi
}
is_installed() { [ -d "$TARGET/raememberit/engine" ] || [ -d "$TARGET/skills/raememberit/engine" ]; }
installed_version() {
  local v; v="$(cfgget version)"
  [ -z "$v" ] && v="$(jq -r '.version // empty' "$TARGET/skills/raememberit/.claude-plugin/plugin.json" 2>/dev/null || true)"
  printf '%s' "${v:-an earlier version}"
}
installed_engine() {
  if [ -d "$TARGET/skills/raememberit/engine" ]; then printf '%s' "$TARGET/skills/raememberit/engine"
  else printf '%s' "$TARGET/raememberit/engine"; fi
}
notes_count() { find "$MEM/feedback" "$MEM/project" "$MEM/reference" "$MEM/archive" "$MEM/interactions" -name '*.md' 2>/dev/null | wc -l | tr -d ' '; }
shipped_reminders() { jq '[.hooks[][].hooks[]] | length' "$SRC/engine/settings.fragment.json" 2>/dev/null || echo 0; }
reminders_count() { jq '[.hooks[][].hooks[]] | length' "$TARGET/skills/raememberit/hooks/hooks.json" 2>/dev/null || echo 0; }
edited_commands() {  # how many of the five memory commands are the person's own text
  local man="$TARGET/raememberit/.installed-commands" n=0 c sum rec
  for c in recall learn memory-reflect memory-audit skill-mine; do
    [ -f "$TARGET/commands/$c.md" ] || continue
    sum=$(shasum "$TARGET/commands/$c.md" | cut -d' ' -f1)
    rec=$(grep " $c.md\$" "$man" 2>/dev/null | cut -d' ' -f1 || true)
    [ "$sum" = "$rec" ] || n=$((n+1))
  done
  printf '%s' "$n"
}
engine_changed() {  # prints the changed files, or "unknown" when there is no record to compare
  local man="$TARGET/raememberit/.installed-engine" eng="$TARGET/raememberit/engine"
  [ -d "$eng" ] || return 0
  if [ ! -f "$man" ]; then printf 'unknown'; return 0; fi
  # basenames only: the folder a tool lives in is not something the person needs to know
  (cd "$eng" && find . -type f | sort | xargs shasum 2>/dev/null) | diff "$man" - | grep '^[<>]' | awk '{print $3}' | sed 's|.*/||' | sort -u
}
engine_current() { [ -z "$(diff -rq "$SRC/engine" "$(installed_engine)" 2>/dev/null | grep -v settings.fragment.json)" ]; }
own_memory_hooks() {  # events on which the person already has memory hooks of their own
  local f
  for f in "$TARGET/settings.json" "$TARGET/settings.local.json"; do
    [ -f "$f" ] || continue
    jq -r '(.hooks // {}) | to_entries[] | .key as $ev | .value[]? | .hooks[]? | .command // ""
           | select(test("memory/MEMORY\\.md|memory/rebuild-index|memory/interactions"))
           | select(test("raememberit") | not) | $ev' "$f" 2>/dev/null
  done | sort -u | tr '\n' ' '
}
budget_words() {
  local st sz bg; read -r st sz bg < "$MEM/.index-status" 2>/dev/null || return 0
  [ -n "${sz:-}" ] || return 0
  if [ "$st" = OVER ]; then printf 'the list Claude reads at the start is %s KB, over its %s KB limit — ask Claude to run /memory-audit' "$((sz/1000))" "$((bg/1000))"
  else printf 'the list Claude reads at the start is %s KB (limit %s KB)' "$((sz/1000))" "$((bg/1000))"; fi
}
claude_md() { printf '%s' "$TARGET/CLAUDE.md"; }
claude_md_instructs() {  # does the person's CLAUDE.md already tell Claude about memories?
  local c; c="$(claude_md)"; [ -f "$c" ] || return 1
  grep -qiE 'raememberit|/learn|/recall|^#+[[:space:]].*\bmemor' "$c" 2>/dev/null || grep -qF "$MEM" "$c" 2>/dev/null
}

preflight() {
  local missing=""
  have jq      || missing="$missing jq"
  have python3 || missing="$missing python3"
  if [ -n "$missing" ]; then
    oops "a helper program is missing:$missing"
    line "Install it, then run this again:"
    line "  Mac:    brew install$missing"
    line "  Ubuntu: sudo apt install$missing"
    exit 1
  fi
  say "I checked your computer:"
  if have claude; then good "Claude Code is installed"
  else flag "I could not find Claude Code on this computer. raememberit only does something inside it."; fi
  good "the helper programs it needs are present"
}

# ── the verbs ───────────────────────────────────────────────────────────────────────
do_install() {
  printf '\n  \033[1mraememberit\033[0m — memory for Claude Code\n'
  preflight; resolve_mem
  if is_installed; then
    note "already installed ($(installed_version)) — this will update it"
    do_update_body; return
  fi
  local existing_notes own
  existing_notes=$(notes_count); own="$(own_memory_hooks)"
  if [ "$existing_notes" -gt 0 ]; then note "found a memory folder with $existing_notes notes at $(tilde "$MEM") — it will not be touched"
  else note "no memory set up yet — this is a first install"; fi
  [ -n "$own" ] && flag "you already have memory reminders of your own (on: $own). I will leave them; they will run alongside mine."

  local default_name; default_name="${NAME:-$(cfgget user)}"; [ -z "$default_name" ] && default_name="${USER:-you}"
  NAME="$(ask_text "What should Claude call you?" "$default_name")"

  say "Here is what I will do:"
  line "1. Put the tools in $(tilde "$TARGET/raememberit")"
  if [ "$existing_notes" -gt 0 ]; then line "2. Leave your memory folder exactly as it is"
  else line "2. Create your memory folder at $(tilde "$MEM"), with 11 starter rules"; fi
  line "3. Let Claude save memories there without asking you every time"
  line "4. Add $(shipped_reminders) background reminders (all quiet unless something needs attention)"
  if claude_md_instructs; then line "5. Leave your $(tilde "$(claude_md)") alone — it already tells Claude about memories"
  else line "5. Add a short note to $(tilde "$(claude_md)") so Claude knows memories exist (I'll show it first)"; fi
  line "Nothing else on your computer is touched. To undo all of it later:  ./raememberit uninstall"
  ask_yn "Go ahead?" y || { line "Nothing was changed."; exit 0; }

  local log="${TMPDIR:-/tmp}/raememberit-install.$$.log"
  if [ "$PLUGIN" = 1 ]; then
    run_quiet "$log" bash "$SRC/install.sh" --plugin --config-dir "$TARGET" --no-guided --user "$NAME" || exit 1
  else
    run_quiet "$log" bash "$SRC/install.sh" --hooks-from-plugin --config-dir "$TARGET" --no-guided --user "$NAME" || exit 1
  fi
  printf '\n'
  good "tools installed ($NEW_VERSION)"
  if [ "$existing_notes" -gt 0 ]; then good "memory folder untouched ($(notes_count) notes)"
  else good "memory folder created — $(notes_count) starter rules to begin with"; fi
  good "Claude can save memories without asking"
  good "$(reminders_count) background reminders in place, all quiet by default"
  claude_md_step
  say "Done. Try it — it takes two minutes:"
  line "1. Start Claude and type:       /recall tail exit code"
  line "   You should get a rule about a build that says OK while failing."
  line "2. Tell Claude one real thing you worked out recently:"
  line "   /learn the staging deploy needs the VPN even though the docs skip it"
  line "3. Quit, start Claude again, and /recall that topic."
  line "   Written in one session, found in the next — that round trip is the whole product."
  printf '\n  If anything looks wrong later:   ./raememberit status\n\n'
  rm -f "$log"
}

do_update() {
  printf '\n  \033[1mraememberit\033[0m — checking your setup\n'
  preflight; resolve_mem
  if ! is_installed; then
    note "raememberit is not installed here yet"
    line "Run:  ./raememberit install"
    exit 1
  fi
  do_update_body
}
do_update_body() {
  local cur edited changed reminders_before
  cur="$(installed_version)"; edited=$(edited_commands); changed="$(engine_changed)"; reminders_before=$(reminders_count)
  say "What I found:"
  good "installed ($cur)"
  if [ "$cur" = "$NEW_VERSION" ] && engine_current; then
    note "this download is the same version — nothing to update"
    [ "$edited" -gt 0 ] && note "$edited of the memory commands are your own edited versions (see: ./raememberit status --commands)"
    printf '\n'; exit 0
  fi
  note "this download is $NEW_VERSION"
  note "your memory folder has $(notes_count) notes — it will not be touched"
  [ "$edited" -gt 0 ] && note "you have edited $edited of the memory commands — $([ "$edited" = 1 ] && echo it || echo they) will be left alone"
  case "$changed" in
    "") : ;;
    unknown) flag "I cannot tell whether you changed any of the background tools yourself, so I will keep a copy of the current ones" ;;
    *) flag "you changed some of the background tools yourself ($(printf '%s' "$changed" | tr '\n' ' '))"
       line "     I will keep your version next to the new one so nothing is lost" ;;
  esac
  [ -n "$(own_memory_hooks)" ] && note "your own memory reminders in settings are left alone, as before"
  [ -z "$NAME" ] && NAME="$(cfgget user)"
  ask_yn "Update now?" y || { line "Nothing was changed."; exit 0; }

  local log="${TMPDIR:-/tmp}/raememberit-update.$$.log"
  if [ "$PLUGIN" = 1 ]; then
    run_quiet "$log" bash "$SRC/install.sh" --plugin --config-dir "$TARGET" --no-guided ${NAME:+--user "$NAME"} || exit 1
  else
    run_quiet "$log" bash "$SRC/install.sh" --hooks-from-plugin --config-dir "$TARGET" --no-guided ${NAME:+--user "$NAME"} || exit 1
  fi
  printf '\n'
  good "tools updated to $NEW_VERSION"
  [ -d "$TARGET/raememberit/engine.prev" ] && line "    your old version is kept at $(tilde "$TARGET/raememberit/engine.prev")"
  local after; after=$(reminders_count)
  if [ "$after" -gt "$reminders_before" ]; then good "background reminders refreshed ($((after-reminders_before)) new, all quiet by default)"
  else good "background reminders refreshed"; fi
  good "memory folder untouched ($(notes_count) notes)"
  if [ "$edited" -gt 0 ]; then
    good "your $(plural "$edited" "edited command") left alone"
    line "    to see what the new versions add:  ./raememberit status --commands"
  fi
  claude_md_step
  say "Done. Restart Claude to pick up the changes."
  printf '\n'; rm -f "$log"
}

do_status() {
  resolve_mem
  if ! is_installed; then
    printf '\n  raememberit is not installed at %s.\n  Run:  ./raememberit install\n\n' "$(tilde "$TARGET")"; exit 1
  fi
  local cur edited changed stale=0 b
  cur="$(installed_version)"; edited=$(edited_commands); changed="$(engine_changed)"
  printf '\n  \033[1mraememberit %s\033[0m — installed at %s' "$cur" "$(tilde "$TARGET")"
  if [ "$cur" = "$NEW_VERSION" ] && engine_current; then printf ', up to date\n'
  else printf '\n'; stale=1; flag "this download is $NEW_VERSION — run:  ./raememberit update"; fi
  if [ -f "$TARGET/skills/raememberit/hooks/hooks.json" ] || grep -q '/raememberit/engine/hooks/' "$TARGET/settings.json" 2>/dev/null; then
    good "background reminders in place ($(reminders_count))"
  else flag "no background reminders found — run:  ./raememberit update"; fi
  b="$(budget_words)"
  if [ -d "$MEM" ]; then good "memory folder: $(notes_count) notes at $(tilde "$MEM")${b:+; $b}"
  else flag "no memory folder at $(tilde "$MEM")"; fi
  if grep -q 'mem-write.sh' "$TARGET/settings.json" 2>/dev/null; then good "Claude can save memories without asking"
  else flag "Claude will be asked before every memory save — run:  ./raememberit update"; fi
  if claude_md_instructs; then good "$(tilde "$(claude_md)") tells Claude about memories"
  else flag "nothing tells Claude that memories exist — run:  ./raememberit update"; fi
  [ "$edited" -gt 0 ] && note "$edited memory commands are your own edited versions"
  case "$changed" in
    ""|unknown) : ;;
    *) note "you changed some background tools yourself: $(printf '%s' "$changed" | tr '\n' ' ')" ;;
  esac
  [ -f "$MEM/.recall-log" ] && note "memories Claude found on its own are being logged, not shown yet ($(wc -l < "$MEM/.recall-log" | tr -d ' ') so far)"
  if [ "$SHOW_COMMANDS" = 1 ] && [ -d "$TARGET/commands" ]; then
    say "Your edited commands against the shipped versions:"
    CLAUDE_CONFIG_DIR="$TARGET" bash "$SRC/tools/diff-commands.sh" --stat 2>/dev/null | sed -n '3,$p' | sed 's/^/  /'
  fi
  if [ "$stale" = 0 ]; then printf '  Nothing to do.\n\n'; exit 0; fi
  printf '\n'; exit 1
}

do_uninstall() {
  printf '\n  \033[1mraememberit\033[0m — uninstall\n'
  resolve_mem
  if ! is_installed && [ ! -d "$TARGET/skills/raememberit" ]; then
    note "raememberit is not installed at $(tilde "$TARGET") — nothing to remove"; printf '\n'; exit 0
  fi
  local n; n=$(notes_count)
  say "This removes raememberit's tools and background reminders."
  if [ "$AND_MEMORIES" = 1 ]; then flag "and, because you asked, your memories too — $n notes at $(tilde "$MEM")"
  else
    line "Your memories — $n notes at $(tilde "$MEM") — stay where they are."
    line "They are plain text files; you can read them with any editor."
  fi
  ask_yn "Remove the tools?" n || { line "Nothing was changed."; exit 0; }
  local log="${TMPDIR:-/tmp}/raememberit-uninstall.$$.log"
  run_quiet "$log" bash "$SRC/uninstall.sh" --config-dir "$TARGET" || exit 1
  printf '\n'
  good "tools and reminders removed"
  claude_md_remove
  if [ "$AND_MEMORIES" = 1 ]; then
    local phrase=""
    if interactive; then printf '\n  To delete %s notes for good, type exactly:  delete my memories\n  > ' "$n"; read -r phrase </dev/tty || phrase=""
    else read -r phrase || phrase=""; fi
    if [ "$phrase" = "delete my memories" ]; then
      rm -rf "$MEM"; good "memories deleted"
    else
      flag "that was not the phrase — memories kept: $n notes at $(tilde "$MEM")"
    fi
  else
    good "memories kept: $n notes at $(tilde "$MEM")"
    printf '\n  To delete the memories as well, run:\n    ./raememberit uninstall --and-my-memories\n  It will ask you to type "delete my memories" before it does.\n'
  fi
  printf '\n'; rm -f "$log"
}

# ── the note in CLAUDE.md ───────────────────────────────────────────────────────────
# Without something in a CLAUDE.md, every reminder fires, every memory is saved, and Claude is never
# told any of it exists — seven green steps and a no-op. So the front door offers to add a short
# note, between markers it can find again, that IMPORTS the longer explanation with an `@` line
# rather than pasting sixty lines into someone's file. If the file already speaks of memories in the
# person's own words, it is left alone. If it does not exist, it is created. Uninstall removes
# exactly the marked block and nothing else.
BEGIN_MARK='<!-- raememberit:begin — added by ./raememberit install, removed by ./raememberit uninstall -->'
END_MARK='<!-- raememberit:end -->'
fragment_path() { if [ "$PLUGIN" = 1 ]; then printf '%s' "$MEM/INSTRUCTIONS-fragment.md"; else printf '%s' "$TARGET/raememberit/INSTRUCTIONS-fragment.md"; fi; }
claude_md_step() {
  local c; c="$(claude_md)"
  if claude_md_instructs; then good "$(tilde "$c") already tells Claude about memories — left alone"; return 0; fi
  local frag; frag="$(fragment_path)"
  say "These are the lines I would add to $(tilde "$c")$([ -f "$c" ] || printf ' (creating it — it does not exist yet)'):"
  printf '  ┌──────────────────────────────────────────────────────────────────────\n'
  printf '  │ %s\n' "$BEGIN_MARK" "## Memory" "@$frag" "$END_MARK"
  printf '  └──────────────────────────────────────────────────────────────────────\n'
  line "The @ line points Claude at the longer explanation, kept here:"
  line "  $(tilde "$frag")"
  if ask_yn "Add them?" y; then
    { [ -f "$c" ] && [ -s "$c" ] && printf '\n'; printf '%s\n' "$BEGIN_MARK" "## Memory" "@$frag" "$END_MARK"; } >> "$c"
    good "added — Claude will now use memories on its own"
  else
    note "not added — Claude will use memories only when you type /recall or /learn yourself."
    line "    To add it later:  ./raememberit update"
  fi
}
claude_md_remove() {
  local c; c="$(claude_md)"; [ -f "$c" ] || return 0
  if grep -qF 'raememberit:begin' "$c"; then
    awk -v b='raememberit:begin' -v e='raememberit:end' '
      index($0,b){skip=1; next} index($0,e){skip=0; next} !skip{print}' "$c" > "$c.tmp" && mv "$c.tmp" "$c"
    if [ -z "$(tr -d '[:space:]' < "$c")" ]; then rm -f "$c"; good "the note in $(tilde "$c") removed — the file held nothing else, so it is gone too"
    else good "the note in $(tilde "$c") removed — the rest of the file is as it was"; fi
  elif claude_md_instructs; then
    note "$(tilde "$c") mentions memories in your own words — left alone"
  fi
}

usage() {
  cat <<'EOF'

  raememberit — memory for Claude Code

    ./raememberit install      set it up (or update it, if it is already here)
    ./raememberit update       bring an existing setup up to this version
    ./raememberit status       is it installed, is it current, is anything wrong
    ./raememberit uninstall    remove the tools — your memories stay

  Add --yes to any of them to take every default without being asked.
  Everything else install.sh can do:  ./raememberit install --advanced --help

EOF
}

# ── arguments ───────────────────────────────────────────────────────────────────────
while [ $# -gt 0 ]; do
  case "$1" in
    install|update|status|uninstall|help) VERB="$1"; shift ;;
    --yes|-y)          YES=1; shift ;;
    --name)            NAME="${2:?}"; shift 2 ;;
    --config-dir)      TARGET="${2:?}"; TARGET_EXPLICIT=1; shift 2 ;;
    --and-my-memories) AND_MEMORIES=1; shift ;;
    --commands)        SHOW_COMMANDS=1; shift ;;
    --advanced)        ADVANCED=1; shift; break ;;
    -h|--help)         usage; exit 0 ;;
    *) oops "I do not know the option '$1'"; usage; exit 2 ;;
  esac
done
if [ "$ADVANCED" = 1 ]; then
  case "$VERB" in
    uninstall) exec bash "$SRC/uninstall.sh" "$@" ;;
    *)         exec bash "$SRC/install.sh" "$@" ;;
  esac
fi
case "$VERB" in
  install)   do_install ;;
  update)    do_update ;;
  status)    do_status ;;
  uninstall) do_uninstall ;;
  *)         usage; exit 2 ;;
esac
